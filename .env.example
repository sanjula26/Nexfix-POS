# Nexfix POS environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets.

VITE_APP_NAME=Nexfix POS

# Demo data is disabled by default. Enable only for local development/demo builds.
# VITE_SEED_DEMO=true

# Supabase public client configuration.
# Use the project's publishable/anon key only; never use service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the UUID of the POS shop created by bootstrap_first_shop().
# It may also be configured in the app's local settings later.
VITE_SUPABASE_SHOP_ID=

# Google Drive backup transport.
# This is a transport credential, not a secret: Vite/Electron bundles are inspectable.
# Store the matching value in Apps Script Script Properties as NEXFIX_BACKUP_API_KEY.
VITE_GOOGLE_BACKUP_API_KEY=
