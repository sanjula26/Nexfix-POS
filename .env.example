# Nexfix POS environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets.

VITE_APP_NAME=Nexfix POS

# Supabase public client configuration.
# Use the project's publishable/anon key only; never use service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the UUID of the POS shop created by bootstrap_first_shop().
# It may also be configured in the app's local settings later.
VITE_SUPABASE_SHOP_ID=

# Optional Google Apps Script deployment URL for backup.
# Google sync remains OFF until explicitly enabled in the application.
VITE_GOOGLE_SCRIPT_URL=
