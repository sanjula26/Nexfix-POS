{
  "name": "nexfix-pos",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Nexfix Solution POS & Inventory — production offline-first electronics POS",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "desktop:build": "npm run build && electron-builder --win --publish never",
    "desktop:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.nexfixsolution.pos",
    "productName": "Nexfix POS",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Nexfix-POS-${version}-${arch}-installer.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Nexfix-POS-${version}-${arch}-portable.${ext}"
    },
    "icon": "build/icon.ico"
  }
}
